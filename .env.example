# Copy to .env and fill in. The key is only needed to geocode a town the cache has
# not seen; everything else in the build runs without one.

# Geoapify forward-geocoding key -- https://myprojects.geoapify.com/
GEOAPIFY_KEY=

# Branding (all optional). Unset or empty values fall back to neutral defaults.
# Keep logo and font files in the gitignored data/ folder, e.g. data/brand/.
# Map title in the header and the browser tab
MAP_TITLE=
# Hex colors like #1f2a44: header and headings, switches and active buttons,
# the header gradient's far end (defaults to the primary), and the header rule
BRAND_COLOR_DARK=
BRAND_COLOR_PRIMARY=
BRAND_COLOR_SECONDARY=
BRAND_COLOR_ACCENT=
# Header logo, a .png, .svg or .webp file (a light logo, it sits on the dark header)
BRAND_LOGO=
# Heading and body fonts, .woff2 files (variable fonts cover every weight)
BRAND_FONT_HEADING=
BRAND_FONT_BODY=
