# Copy to .env and fill in. Only the city map needs this;
# zoneMap.py renders the KMZ with no key at all.

# Geoapify forward-geocoding key -- https://myprojects.geoapify.com/
GEOAPIFY_KEY=

# Only for the CARTO basemaps ("voyager", "positron", "dark"); the default "gray"
# needs no key. Request one at https://carto.com/basemaps/apikey -- note their free
# tier is licensed for non-commercial use only.
CARTO_API_KEY=
